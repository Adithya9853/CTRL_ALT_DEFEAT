# Copy this file to .env and fill in what you need. Never share or commit .env.

# Port the website runs on
PORT=3000

# First Security Desk login (created on first start if no staff account exists).
# If STAFF_PASSWORD is empty, a random password is printed once in the terminal.
STAFF_ID=SECURITY01
STAFF_PASSWORD=

# AI — set ONE of these. Gemini has a free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Or use Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# Where data and photos are saved (default: ./data)
# DATA_DIR=./data

# Link included in WhatsApp messages, e.g. http://192.168.1.20:3000 or your hosted URL
APP_URL=

# --- WhatsApp alerts (optional). Set ONE option. Without it, staff send messages with one tap. ---
# Option 1: Twilio WhatsApp (sandbox works for a demo): https://console.twilio.com → Messaging → Try WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Option 2: Meta WhatsApp Cloud API: https://developers.facebook.com → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=      (approved template with one {{1}} variable, needed for first contact)
# WHATSAPP_API_VERSION=v23.0
